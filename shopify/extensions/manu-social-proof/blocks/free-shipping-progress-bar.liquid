<div
  class="manu-free-shipping-progress manu-free-shipping-progress--inline"
  data-manu-free-shipping-config
  data-placement="inline"
  data-threshold="{{ block.settings.threshold | escape }}"
  data-message-away="{{ block.settings.message_away | escape }}"
  data-message-unlocked="{{ block.settings.message_unlocked | escape }}"
  style="--manu-shipping-fill: {{ block.settings.fill_color }}; --manu-shipping-track: {{ block.settings.track_color }}; --manu-shipping-text: {{ block.settings.text_color }};"
>
  <div class="manu-free-shipping-progress__track" role="progressbar" aria-label="Free shipping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <span class="manu-free-shipping-progress__fill"></span>
  </div>
  <p class="manu-free-shipping-progress__message" role="status" aria-live="polite"></p>
</div>

{% schema %}
{
  "name": "Shipping progress bar",
  "target": "section",
  "javascript": "free-shipping-progress.js",
  "stylesheet": "free-shipping-progress.css",
  "settings": [
    { "type": "text", "id": "threshold", "label": "Envío gratis desde (moneda del carrito)", "default": "100" },
    { "type": "text", "id": "message_away", "label": "Mensaje antes del mínimo", "default": "You are {amount} away from FREE SHIPPING!", "info": "Usa {amount} donde deba aparecer el monto restante." },
    { "type": "text", "id": "message_unlocked", "label": "Mensaje al alcanzar el mínimo", "default": "Your cart qualifies for FREE SHIPPING!" },
    { "type": "color", "id": "fill_color", "label": "Color de avance", "default": "#8c2029" },
    { "type": "color", "id": "track_color", "label": "Color de fondo de la barra", "default": "#e9e9e9" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#171717" }
  ]
}
{% endschema %}
